#include <env/ti/ti_common.env>
#include <env/ti/mmc.env>
#include <env/ti/k3_dfu.env>
#if CONFIG_CMD_REMOTEPROC
#include <env/ti/k3_rproc.env>
#endif

name_kern=Image
console=ttyS2,115200n8
args_all=setenv optargs ${optargs} earlycon=ns16550a,mmio32,0x02800000
	${mtdparts}
run_kern=booti ${loadaddr} ${rd_spec} ${fdtaddr}

boot_targets=mmc1 mmc0 usb dhcp
boot=mmc
mmcdev=1
bootpart=0:2
bootdir=/boot
fdtfile=k3-am625-carbon.dtb
rd_spec=-

/* Override TI */
scriptaddr=0x81000000

splashfile=ezurio.bmp
splashimage=0x80200000
splashpos=m,m
splashsource=mmc
rproc_fw_binaries= 0 /lib/firmware/am62-mcu-m4f0_0-fw

uboot_defconfig=CONFIG_DEFCONFIG

/* Set SDIO_A Mux to SDCARD
 * Because the u-boot driver for ti,tca9539 has not
 * implemented gpio-hog
*/
sdio_a_sel=echo "SDIO_A -> SDCARD"; gpio clear gpio@75_8;

#if CONFIG_BOOTMETH_ANDROID
#include <env/ti/android.env>
force_avb=0
adtb_idx=0
get_adtb_idx=
	if test ${board_name} = am62x_lp_skevm; then
		setenv adtb_idx 1;
	else
		setenv adtb_idx 0;
	fi;
bootcmd=run get_adtb_idx; bootflow scan -lb
#endif
